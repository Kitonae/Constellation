# Rust
/target/
**/*.rs.bk
Cargo.lock

# Node
node_modules/
dist/
build/
# The Wails v3 build directory holds tracked source (Taskfiles, config.yml and
# the Windows manifest/info), not just artifacts.
!editor/wails/build/
editor/wails/build/*
!editor/wails/build/Taskfile.yml
!editor/wails/build/config.yml
!editor/wails/build/appicon.png
!editor/wails/build/windows/
editor/wails/build/windows/*
!editor/wails/build/windows/Taskfile.yml
!editor/wails/build/windows/info.json
!editor/wails/build/windows/wails.exe.manifest
.vite/
playwright-report/
test-results/
.env
.env.*

# Editor
.idea/
# .vscode/
!.vscode/launch.json
!.vscode/tasks.json
**/.claude/settings.local.json
*.swp
*.swo
*.bak
.DS_Store
Thumbs.db

# Logs
*.log

# OS
*.tmp
*.temp

# Byproducts
*.pdb
*.d
*.exe
*.dll
*.obj
*.class
*.out
*.pyc
*.pyo

# Tauri
/src-tauri/target/
/src-tauri/.cargo/
/src-tauri/Cargo.lock

# Misc
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Examples
examples/*.json

# Keep the embedded Wails frontend placeholder tracked
!editor/wails/frontend/
editor/wails/frontend/*
!editor/wails/frontend/dist/
editor/wails/frontend/dist/*
!editor/wails/frontend/dist/.keep

# go-task cache
.task/
