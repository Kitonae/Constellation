{
  "$comment": "DEPRECATED: This Tauri configuration is being replaced by Wails. See ../wails/",
  "package": {
    "productName": "Constellation Editor",
    "version": "0.1.0"
  },
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "npm --prefix ../ui run build",
    "devPath": "http://localhost:5173",
    "distDir": "../ui/dist"
  },
  "tauri": {
    "allowlist": {
      "all": true,
      "fs": {
        "scope": [
          "$APPCACHE/*",
          "$APPCACHE/**",
          "$APPLOCALDATA/*",
          "$APPLOCALDATA/**",
          "$HOME/*",
          "$HOME/**",
          "$PICTURE/*",
          "$PICTURE/**",
          "$DOCUMENT/*",
          "$DOCUMENT/**",
          "$DOWNLOAD/*",
          "$DOWNLOAD/**"
        ]
      }
    },
    "bundle": { 
      "identifier": "com.constellation.editor",
      "icon": ["icon.ico"]
    },
    "windows": [
      { "title": "Constellation Editor", "width": 1440, "height": 900 }
    ]
  }
}
