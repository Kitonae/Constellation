{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "chrome",
            "request": "launch",
            "name": "Launch Website",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}/website",
            "preLaunchTask": "npm: dev",
            "sourceMapPathOverrides": {
                "webpack:///./*": "${webRoot}/*"
            }
        }
    ]
}